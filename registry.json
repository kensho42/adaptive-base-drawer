        },
        {
          "path": "src/use-element-height.ts",
          "type": "registry:ui",
          "target": "@ui/adaptive-base-drawer/use-element-height.ts"
        },
        {
          "path": "src/index.ts",
          "type": "registry:ui",
          "target": "@ui/adaptive-base-drawer/index.ts"
        }
      ]
    }
  ]
