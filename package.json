{
  "name": "adaptive-base-drawer",
  "version": "0.1.0",
  "description": "Adaptive-height shadcn/Base UI Drawer with smooth Motion-powered content transitions.",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "build": "vite build && vite build --config vite.lib.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.2",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.2",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.3"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/adaptive-base-drawer.css"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.8.0",
    "motion": "^14.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kensho42/adaptive-base-drawer.git"
  },
  "homepage": "https://github.com/kensho42/adaptive-base-drawer#readme",
  "bugs": {
    "url": "https://github.com/kensho42/adaptive-base-drawer/issues"
